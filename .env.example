# -----------------------------------------------------------------------------
# Auvyren environment template
# Copy to `.env` at the repository root and replace every placeholder,
# or run: npm run setup:env
# Never commit `.env`.
# -----------------------------------------------------------------------------

# PostgreSQL (consumed by docker-compose.yml)
POSTGRES_DB=auvyren
POSTGRES_USER=auvyren
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Host port for local development only; the Compose stack binds it to 127.0.0.1.
POSTGRES_PORT=5432
# Local API/tests connect through the host port above. The Compose API uses its
# own in-network URL (db:5432) and ignores this value.
DATABASE_URL=postgresql+asyncpg://auvyren:replace-with-a-strong-local-password@localhost:5432/auvyren

# Production-style Compose stack (Caddy + Mailpit)
# The browser-facing origin is served through Caddy with a local CA.
PUBLIC_ORIGIN=https://localhost:8443
APP_HTTPS_PORT=8443
MAILPIT_UI_PORT=8025
BACKUP_RETENTION_DAYS=14

# API — core (local development)
APP_ENV=development
APP_NAME=Auvyren API
APP_VERSION=0.1.0
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
WEB_APP_URL=http://localhost:3000
DOCS_ENABLED=true
API_V1_PREFIX=/api/v1
# Keep enabled in production. Playwright disables it only for its API process.
RATE_LIMIT_ENABLED=true

# API — sessions and browser authentication
SESSION_COOKIE_NAME=auv_session
SESSION_COOKIE_SECURE=false
# Optional parent domain (for example .auvyren.app). Leave empty for host-only.
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
SESSION_REFRESH_MINUTES=5
CSRF_COOKIE_NAME=auv_csrf
CSRF_HEADER_NAME=X-CSRF-Token
PASSWORD_RESET_TTL_MINUTES=30

# API — email (password reset delivery)
# console: reset links are written to the API log (development only)
# smtp: real delivery through the configured SMTP server
# Production requires smtp; the console adapter is rejected there.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@auvyren.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# API — AI foundation (activated in Phase 4)
# Local AI is optional. Cloud AI is disabled unless explicitly configured.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
AI_KEY_ENCRYPTION_KEY=
