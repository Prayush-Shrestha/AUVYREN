{
  "name": "auvyren",
  "version": "0.1.0",
  "private": true,
  "description": "Auvyren — a local-first personal operating system for clear thinking and intentional action.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "setup:env": "node scripts/setup-env.mjs",
    "dev:web": "npm run dev --workspace @auvyren/web",
    "dev:api": "node scripts/api.mjs -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build:web": "npm run build --workspace @auvyren/web",
    "lint:web": "npm run lint --workspace @auvyren/web",
    "typecheck:web": "npm run typecheck --workspace @auvyren/web",
    "lint:api": "node scripts/api.mjs -m ruff check app tests",
    "format:api": "node scripts/api.mjs -m ruff format app tests",
    "format:check:api": "node scripts/api.mjs -m ruff format --check app tests",
    "test:api": "node scripts/api.mjs -m pytest",
    "test:web": "npm run test --workspace @auvyren/web",
    "test:e2e": "npm run test:e2e --workspace @auvyren/web",
    "test:e2e:mobile": "npm run test:e2e --workspace @auvyren/web -- --project=mobile",
    "perf:web": "node scripts/web-budget.mjs --browser",
    "perf:ci": "node scripts/web-budget.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:dev": "npm audit --audit-level=high",
    "check": "npm run lint:web && npm run typecheck:web && npm run test:web && npm run lint:api && npm run test:api",
    "migrate": "node scripts/api.mjs -m alembic upgrade head",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-backup.sh --restore",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:health": "bash scripts/stack-health.sh",
    "stack:config": "docker compose config --quiet"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
